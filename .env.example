# Runtime profile
SPRING_PROFILES_ACTIVE=dev

# Server
PORT=8080

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/krushikranti_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=

# Security
JWT_SECRET=generate_a_strong_random_secret_for_jwt_here_min_256_bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail / SMTP Server (e.g., Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket Integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Google OAuth2 Config
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_FRONTEND_SUCCESS_URL=http://localhost:5173
